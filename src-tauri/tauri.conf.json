{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmo Symphony",
  "version": "1.4.5",
  "identifier": "MicroMeadow.CosmoSymphony",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:55174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
        {
          "label": "main",
          "title": "",
          "width": 1280,
          "height": 720,
          "resizable": true,
          "fullscreen": false,
          "decorations": false,
          "transparent": false,
          "shadow": true,
          "visible": false,
          "devtools": true,
          "backgroundColor": "#0a0a10"
        }
      ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: cosmo: http://localhost:* http://127.0.0.1:* ws://localhost:*; img-src 'self' asset: cosmo: data: blob: https://asset.localhost http://asset.localhost https://cosmo.localhost http://cosmo.localhost; media-src 'self' asset: cosmo: blob: data: https://asset.localhost http://asset.localhost https://cosmo.localhost http://cosmo.localhost *; connect-src 'self' cosmo: http://localhost:* http://127.0.0.1:* ws://localhost:* ipc.localhost:* http://cosmo.localhost https://cosmo.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "*/**",
          "A:\\**", "A:/**",
          "B:\\**", "B:/**",
          "C:\\**", "C:/**",
          "D:\\**", "D:/**",
          "E:\\**", "E:/**",
          "F:\\**", "F:/**",
          "G:\\**", "G:/**",
          "H:\\**", "H:/**",
          "I:\\**", "I:/**",
          "J:\\**", "J:/**",
          "K:\\**", "K:/**",
          "L:\\**", "L:/**",
          "M:\\**", "M:/**",
          "N:\\**", "N:/**",
          "O:\\**", "O:/**",
          "P:\\**", "P:/**",
          "Q:\\**", "Q:/**",
          "R:\\**", "R:/**",
          "S:\\**", "S:/**",
          "T:\\**", "T:/**",
          "U:\\**", "U:/**",
          "V:\\**", "V:/**",
          "W:\\**", "W:/**",
          "X:\\**", "X:/**",
          "Y:\\**", "Y:/**",
          "Z:\\**", "Z:/**",
          "\\\\*\\**",
          "\\\\?\\**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "cosmo_enhance.py",
      "convert_heic.py",
      "demos/*",
      "resources/ffmpeg.exe",
      "resources/ffprobe.exe",
      "resources/wifi-share-web/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "webm", "mov", "mkv", "avi", "png", "jpg", "jpeg", "webp"],
        "name": "Cosmo Symphony Media",
        "description": "Media file playable in Cosmo Symphony Workspace"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}

